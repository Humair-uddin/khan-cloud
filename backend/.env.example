APP_NAME=Khan Cloud
APP_VERSION=0.1.0
APP_ENV=development

API_PREFIX=/api/v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=khan_cloud
POSTGRES_USER=khan
POSTGRES_PASSWORD=replace_with_secure_password

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=replace_with_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# MikroTik RouterOS gateway integration
MIKROTIK_BASE_URL=https://10.10.20.1
MIKROTIK_USERNAME=khan-cloud
MIKROTIK_PASSWORD=replace_with_secure_password
MIKROTIK_VERIFY_TLS=true
MIKROTIK_CA_FILE=/etc/ssl/certs/ca-certificates.crt
MIKROTIK_TIMEOUT_SECONDS=10
MIKROTIK_LIVE_ENABLED=false
